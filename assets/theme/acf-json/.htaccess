# The ACF field definitions are read by WordPress only: no web access. This file travels with the theme (the
# Duplicator import replaces the root .htaccess). A server that ignores .htaccess (nginx) needs the same rule in its
# own config: references/gotchas.md, Staging.
<IfModule mod_authz_core.c>
	Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
	Order deny,allow
	Deny from all
</IfModule>
