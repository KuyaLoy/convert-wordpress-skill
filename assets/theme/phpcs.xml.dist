<?xml version="1.0"?>
<ruleset name="{{SITE_NAME}} theme">
    <description>Security, i18n, prefixing and PHP 8.1 to 8.4 compatibility for the theme.</description>

    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/js/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <config name="testVersion" value="8.1-8.4"/>
    <config name="minimum_wp_version" value="6.9"/>

    <rule ref="PHPCompatibilityWP"/>

    <rule ref="WordPress.Security"/>
    <!-- The kit's helpers that escape or return safe HTML, so `echo kitwp_img( ... )` needs no ignore comment.
         Add the build's own helpers here; a blanket phpcs:ignore is a QA finding. Remove helpers the theme drops. -->
    <rule ref="WordPress.Security.EscapeOutput">
        <properties>
            <property name="customEscapingFunctions" type="array">
                <element value="kitwp_inline"/>
                <element value="kitwp_svg_clean"/>
            </property>
            <property name="customAutoEscapedFunctions" type="array">
                <element value="kitwp_html"/>
                <element value="kitwp_icon"/>
                <element value="kitwp_img"/>
                <element value="kitwp_asset_img"/>
                <element value="kitwp_img_tag"/>
                <element value="kitwp_inline_svg"/>
                <element value="kitwp_map_iframe"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPress.WP.GlobalVariablesOverride"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="kitwp"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="kitwp"/>
            </property>
        </properties>
    </rule>
</ruleset>
