# Text files are stored and checked out with LF, so the scripts work on every OS
* text=auto eol=lf

# Binary files are never converted
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary

# The website and the GitHub workflow are not part of the skill: release archives leave them out
site/ export-ignore
.github/ export-ignore
